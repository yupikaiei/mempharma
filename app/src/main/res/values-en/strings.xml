<?xml version="1.0" encoding="utf-8"?>
<!-- English. Used either when the phone is set to English or when English is
     picked in Settings; otherwise the Portuguese default in res/values is used.

     This file must stay key-for-key identical to res/values/strings.xml.
     Copy rules (please keep them when editing):
       • Never write "pill(s)". Use the `unit_pill` plurals below — the stored
         default label in `unit_pill_default` is only a marker that
         `util/Units.kt` swaps for the right singular/plural at render time.
       • Quote with “ ” (never straight \" quotes).
       • Errors are instructions ("Enter…"), never a repeat of the field label.
       • Impersonal, calm voice — no first person. -->
<resources>
    <string name="app_name">MemPharma</string>

    <!-- Shared -->
    <string name="common_cancel">Cancel</string>
    <string name="common_delete">Delete</string>
    <string name="common_refill">Refill</string>
    <string name="common_add_medicine">Add medicine</string>
    <string name="common_back">Back</string>
    <string name="common_change">Change</string>
    <string name="common_remove">Remove</string>
    <string name="common_stop">Stop</string>
    <string name="common_preview">Preview</string>
    <string name="common_save_number">Save number</string>
    <string name="common_choose_contact">Choose contact</string>
    <string name="common_type_number_instead">Type the number</string>
    <string name="common_share_medicine_history">Share medicine history</string>
    <string name="common_dose_detail">%1$d %2$s • %3$s</string>

    <!-- The noun for one/several pills. Kept out of the sentences above and
         swapped in by util/Units.kt so it always agrees with the number. -->
    <plurals name="unit_pill">
        <item quantity="one">pill</item>
        <item quantity="other">pills</item>
    </plurals>
    <!-- Marker stored on a medicine that was never given a custom unit name.
         Never shown directly to the person — see util/Units.kt. -->
    <string name="unit_pill_default">pills</string>

