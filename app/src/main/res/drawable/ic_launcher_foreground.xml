<!-- Simple, high-contrast pill/capsule mark on a 108dp adaptive-icon canvas.
     The safe zone is the central 66dp circle, so we keep the glyph inside it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Capsule body -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38,44 L70,44 A10,10 0 0 1 80,54 A10,10 0 0 1 70,64 L38,64 A10,10 0 0 1 28,54 A10,10 0 0 1 38,44 Z" />
    <!-- Capsule split line -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFE8633A"
        android:strokeWidth="3"
        android:pathData="M54,44 L54,64" />
    <!-- Cross/plus reminder accent -->
    <path
        android:fillColor="#FFE8633A"
        android:pathData="M66,26 L72,26 L72,32 L78,32 L78,38 L72,38 L72,44 L66,44 L66,38 L60,38 L60,32 L66,32 Z" />
</vector>
